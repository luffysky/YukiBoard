<?xml version="1.0" encoding="utf-8"?>
<!--
    輸入法宣告檔（Input Method XML）。
    Android 系統讀取此檔決定 IME 的語言支援與設定 Activity。
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.snowrealm.yukiboard.ui.settings.SettingsActivity"
    android:isDefault="false">

    <!-- 英文（美式 QWERTY） -->
    <subtype
        android:label="@string/subtype_english"
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true" />

    <!-- 繁體中文注音 -->
    <subtype
        android:label="@string/subtype_bopomofo"
        android:imeSubtypeLocale="zh_TW"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="false" />

</input-method>
