<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 語音輸入權限 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 震動回饋 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 感測器（搖手機復原 + 陀螺儀游標） -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <!-- 網路（WiFi 遠端鍵盤 + 主題雲端同步） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 懸浮面板 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 天氣定位 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 藍牙 HID 鍵盤 -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <!-- OpenGL ES 2.0 需求宣告 -->
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.YukiBoard">

        <!-- IME Service 主宣告 -->
        <service
            android:name=".service.YukiBoardIMEService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- 設定 Activity（輸入法設定頁面，供系統設定跳轉） -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 功能說明 & 使用教學 -->
        <activity
            android:name=".ui.settings.HelpActivity"
            android:label="功能說明"
            android:exported="false" />

        <!-- AI 設定頁面 -->
        <activity
            android:name=".ui.settings.AISettingsActivity"
            android:label="AI 設定"
            android:exported="false" />

        <activity
            android:name=".ui.settings.InputTestActivity"
            android:label="輸入法測試"
            android:exported="false" />

        <activity
            android:name=".ui.settings.ApiGuideActivity"
            android:label="AI 服務申請教學"
            android:exported="false" />

        <!-- 邀請碼頁面 -->
        <activity
            android:name=".ui.auth.InviteCodeActivity"
            android:label="輸入邀請碼"
            android:exported="false" />

        <!-- 登入頁面 -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:label="登入 SnowRealm"
            android:exported="false" />

        <!-- Z幣錢包 -->
        <activity
            android:name=".ui.currency.ZCoinWalletActivity"
            android:label="Z幣錢包"
            android:exported="false" />

        <!-- 背景選擇器（IME 代理用透明 Activity） -->
        <activity
            android:name=".ui.settings.BackgroundPickerActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false" />

        <!-- 貼圖/GIF 圖片分享用 FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
