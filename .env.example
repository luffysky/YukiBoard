# YukiBoard 環境變數範本
# 複製此檔案為 .env 並填入對應值
# .env 已在 .gitignore 中，不會被提交

# ══════════════════════════════════════════
# AI Provider Keys（開發用，正式版由使用者自行輸入）
# ══════════════════════════════════════════
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ══════════════════════════════════════════
# Claw AI 邀請碼 HMAC 簽名金鑰
# ══════════════════════════════════════════
INVITE_HMAC_SECRET=yukiboard_dev_2026

# ══════════════════════════════════════════
# SnowRealm Insight Engine（帳號 + 貼圖 API）
# ══════════════════════════════════════════
INSIGHT_API_BASE_URL=https://insight.snowrealm.pet
PLATFORM_API_KEY=

# ══════════════════════════════════════════
# YukiBoard 獨立 Supabase（Zeabur 新專案）
# ══════════════════════════════════════════
YUKIBOARD_SUPABASE_URL=
YUKIBOARD_SUPABASE_ANON_KEY=

# ══════════════════════════════════════════
# 第三方 API
# ══════════════════════════════════════════
GIPHY_API_KEY=
OPENWEATHER_API_KEY=

# ══════════════════════════════════════════
# 藍新金流（Z幣儲值）
# ══════════════════════════════════════════
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASH_KEY=
NEWEBPAY_HASH_IV=
